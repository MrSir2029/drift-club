{
  "name": "Drift Club",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install",
  "postAttachCommand": "npm start",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Drift Club",
      "onAutoForward": "openBrowser"
    }
  },
  "hostRequirements": { "cpus": 2 }
}
